# ──────────────────────────────────────────────────────
# JOB SeArCh — Environment Configuration
# ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# All services used here have FREE tiers.

# ─── Supabase (free tier: 500MB DB, pgvector included) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOi...your-anon-key...

# ─── Google Gemini API (free tier: 1500 req/min embeddings, 15 req/min flash) ───
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Scraper Settings ───
# Comma-separated list of Greenhouse board tokens to scrape
# Find a company's token: visit their careers page, look for boards.greenhouse.io/XXXXX
GREENHOUSE_BOARDS=hashicorp,figma,cloudflare,vercel,supabase,linear,notion

# Comma-separated list of Lever company slugs
# Find a company's slug: visit their jobs page, look for jobs.lever.co/XXXXX
LEVER_COMPANIES=anduril,ramp,brex,deel

# Keywords to filter jobs (only ingest jobs matching at least one keyword)
JOB_KEYWORDS=engineer,developer,software,frontend,backend,fullstack,full-stack,devops,data,machine learning,AI,product

# Maximum jobs to scrape per source per run (to stay within free tier limits)
MAX_JOBS_PER_SOURCE=50

# How often to run the scraper (in hours) when using the scheduler
SCRAPE_INTERVAL_HOURS=6
