# ──────────────────────────────────────────────────────
# JOB SeArCh — Backend Environment Configuration
# ──────────────────────────────────────────────────────
# Copy this file to backend/.env and replace placeholder values.
# NEVER commit the actual .env file or real secrets to Git.

# ─── Supabase (PostgreSQL with pgvector) ───
SUPABASE_URL=https://your-project.supabase.co
# Public anon key for client-safe operations:
SUPABASE_KEY=your-supabase-anon-key-here
# Service role key (OPTIONAL - only needed for elevated ETL/scraper bulk operations, keep private!):
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
# Supabase JWT Secret (optional):
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ─── AI Providers (Groq & Gemini) ───
# Groq API (Free Tier: Llama 3.3 70B & 8B inference)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Google Gemini API (Optional fallback for embeddings & LLM)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Scraper Settings ───
# Comma-separated list of Greenhouse board tokens to scrape
GREENHOUSE_BOARDS=figma,cloudflare,vercel,stripe,gitlab,discord,coinbase

# Comma-separated list of Lever company slugs
LEVER_COMPANIES=anduril,ramp,brex,deel

# Comma-separated list of Ashby company slugs
ASHBY_COMPANIES=flutterflow,linear

# Keywords to filter jobs (only ingest jobs matching at least one keyword)
JOB_KEYWORDS=engineer,developer,software,frontend,backend,fullstack,full-stack,devops,data,machine learning,AI,product

# Maximum jobs to scrape per source per run
MAX_JOBS_PER_SOURCE=50

# How often to run the background scheduler (in hours)
SCRAPE_INTERVAL_HOURS=6

# ─── Server Settings ───
HOST=0.0.0.0
PORT=8000
