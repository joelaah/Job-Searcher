# ──────────────────────────────────────────────────────
# JOB SeArCh — Frontend / Application Environment Example
# ──────────────────────────────────────────────────────
# Use these compile-time flags with Flutter when building or running:
# flutter run -d chrome --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
#
# Alternatively, Supabase credentials can be entered dynamically in the
# UI via the "Connect DB" modal, and will be persisted locally in browser localStorage.

# ─── Supabase Configuration ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ─── Backend Service URL ───
# Points to local FastAPI daemon or hosted production backend
BACKEND_URL=http://localhost:8000
